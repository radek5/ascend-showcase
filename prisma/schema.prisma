// ============================================================
// ASCEND FOOTBALL SHOWCASE
// Core data model
// Prisma 7
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum RegistrationStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum RegistrationStep {
  PLAYER
  CONTACT
  REPRESENTATION
  VIDEO
  MEDICAL_CONSENT
  DECLARATIONS
  PRIVACY_MEDIA
  REVIEW
  PAYMENT
  CONFIRMATION
}

enum RepresentationStatus {
  UNREPRESENTED_OPEN
  REPRESENTED
  STATUS_UNCLEAR
}

enum RepresentationVerificationStatus {
  DECLARED
  PENDING_REVIEW
  AGENT_CONFIRMATION_PENDING
  CONFIRMED
  DISPUTED
}

enum RepresentationChangeType {
  INITIAL_DECLARATION
  UPDATED_BY_PLAYER
  UPDATED_BY_GUARDIAN
  UPDATED_BY_ADMIN
  AGENT_CONFIRMED
  AGENT_DISPUTED
}

enum ExclusiveRepresentation {
  YES
  NO
  UNKNOWN
}

enum VideoStatus {
  NOT_SUBMITTED
  SUBMITTED
  PROCESSING
  READY
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ScoutInterestLevel {
  WATCH
  INTERESTED
  HIGH_INTEREST
  REQUEST_INTRODUCTION
  CLOSED
}

enum IntroductionStatus {
  REQUESTED
  REVIEWING
  APPROVED
  DECLINED
  INTRODUCED
  FOLLOW_UP
  CLOSED
}

enum IntroductionPartyType {
  PLAYER
  GUARDIAN
  AGENT
}

enum ProspectStatus {
  NOT_ELIGIBLE
  POTENTIAL
  REVIEW
  APPROVED
  DECLINED
  REPRESENTATION_DISCUSSION
  SIGNED
}

enum StaffRole {
  ADMIN
  STAFF
}

enum ProfessionalRegistrationRole {
  CLUB_REPRESENTATIVE
  SCOUT
  FOOTBALL_AGENT
}

enum ProfessionalRegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  MORE_INFO_REQUIRED
  REJECTED
  ACCREDITED
  CHECKED_IN
}

model ProfessionalRegistration {
  id String @id @default(cuid())

  // Event
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Accreditation
  accreditationNumber    String?   @unique
  checkInToken           String?   @unique
  checkedInAt            DateTime?
  checkedInByStaffUserId String?
  approvalEmailSentAt    DateTime?

  status ProfessionalRegistrationStatus @default(DRAFT)
  role   ProfessionalRegistrationRole

  // Identity / contact
  fullName String
  email    String
  phone    String

  // Headshot
  headshotUrl String?

  // Arrival
  arrivalTransfer Boolean   @default(false)
  arrivalDate     DateTime?
  arrivalTime     String?
  arrivalAirline  String?
  arrivalFlight   String?

  // Departure
  departureTransfer Boolean   @default(false)
  departureDate     DateTime?
  departureTime     String?
  departureAirline  String?
  departureFlight   String?

  // Accommodation
  hotelStatus  String?
  lagosAddress String?

  // Event declarations
  safeguardingConsent Boolean @default(false)
  privacyConsent      Boolean @default(false)

  // Administration
  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Future ASCEND communications / mailing list
  futureEventConsent   Boolean   @default(false)
  futureEventConsentAt DateTime?

  @@index([eventId])
  @@index([status])
  @@index([role])
  @@index([email])
}

model StaffUser {
  id String @id @default(cuid())

  name  String
  email String @unique

  passwordHash String

  role   StaffRole @default(STAFF)
  active Boolean   @default(true)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// EVENT
// ------------------------------------------------------------

model Event {
  id      String @id @default(cuid())
  slug    String @unique
  name    String
  edition String

  city    String
  country String
  venue   String

  // Event registration / check-in
  registrationVenue        String?
  registrationInstructions String?

  registrationStartsAt DateTime?
  registrationEndsAt   DateTime?

  footballStartsAt DateTime?
  footballEndsAt   DateTime?

  registrationOpen Boolean @default(false)
  active           Boolean @default(false)

  capacity Int?

  // Registration pricing
  registrationFeeAmount   Int?
  registrationFeeCurrency String @default("NGN")

  registrations Registration[]
  scouts        Scout[]
  introductions Introduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professionalRegistrations ProfessionalRegistration[]

  @@index([active])
  @@index([city])
}

// ------------------------------------------------------------
// REGISTRATION / PLAYER
// ------------------------------------------------------------

model Registration {
  id String @id @default(cuid())

  registrationNumber String? @unique

  // Event check-in
  checkInToken            String?   @unique
  checkedInAt             DateTime?
  checkedInByStaffUserId  String?
  confirmationEmailSentAt DateTime?

  status      RegistrationStatus @default(DRAFT)
  currentStep RegistrationStep   @default(PLAYER)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  // Player identity
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?
  nationality       String?
  primaryPosition   String?
  secondaryPosition String?
  preferredFoot     String?
  currentClub       String?
  academyName       String?

  // Player headshot / accreditation photo
  headshotUrl String?
 
  // Optional football information
  heightCm Int?
  weightKg Int?

  // Player contact
  email String?
  phone String?

  // Guardian / emergency contact
  guardianName         String?
  guardianRelationship String?
  guardianEmail        String?
  guardianPhone        String?

  emergencyContactName  String?
  emergencyContactPhone String?

  // Representation
  representationStatus RepresentationStatus?
  prospectStatus       ProspectStatus        @default(POTENTIAL)

  // Medical / consent
  medicalNotes           String?
  medicalConsent         Boolean  @default(false)
  eventConsent           Boolean  @default(false)
  privacyConsent         Boolean  @default(false)
  mediaConsent           Boolean?
  declarationConsent     Boolean  @default(false)
  playerAgreementConsent Boolean  @default(false)

  // Terms & Conditions
  termsConsent Boolean @default(false)

  // Related records
  representationDeclaration RepresentationDeclaration?
  representationHistory     RepresentationHistory[]

  // Future ASCEND communications / mailing list
  futureEventConsent   Boolean   @default(false)
  futureEventConsentAt DateTime?

  videos PlayerVideo[]

  payments Payment[]

  scoutInterests ScoutInterest[]

  introductions Introduction[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  assessment PlayerAssessment?

  @@index([eventId])
  @@index([status])
  @@index([representationStatus])
  @@index([prospectStatus])
  @@index([email])
}

model PlayerAssessment {
  id String @id @default(cuid())

  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id])

  source String @default("DEMO")

  overallScore   Int?
  technicalScore Int?
  tacticalScore  Int?
  physicalScore  Int?

  movementScore        Int?
  positioningScore     Int?
  decisionMakingScore  Int?
  passingScore         Int?
  defensiveImpactScore Int?
  ballControlScore     Int?
  tacklingScore        Int?
  aerialAbilityScore   Int?
  workRateScore        Int?
  composureScore       Int?

  topSpeedKmh       Decimal?
  distanceCoveredKm Decimal?
  sprintCount       Int?
  highIntensityRuns Int?
  accelerations     Int?

  aiSummary String?

  confidenceScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// REPRESENTATION DECLARATION
// ------------------------------------------------------------

model RepresentationDeclaration {
  id String @id @default(cuid())

  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id])

  status RepresentationStatus

  verificationStatus RepresentationVerificationStatus @default(DECLARED)

  // Existing representative details
  agentName         String?
  agencyName        String?
  agentEmail        String?
  agentPhone        String?
  agentCountry      String?
  fifaLicenceNumber String?

  representationStart DateTime?
  representationEnd   DateTime?

  exclusiveRepresentation ExclusiveRepresentation?

  agentContactConsent              Boolean  @default(false)
  interestedInAscendRepresentation Boolean?

  // Player/guardian declaration
  declarationConfirmed Boolean   @default(false)
  declaredByName       String?
  declaredAt           DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------
// REPRESENTATION HISTORY / AUDIT
// ------------------------------------------------------------

model RepresentationHistory {
  id String @id @default(cuid())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  previousStatus RepresentationStatus?
  newStatus      RepresentationStatus

  changeType RepresentationChangeType

  changedByName String?
  reason        String?

  createdAt DateTime @default(now())

  @@index([registrationId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// PLAYER VIDEO
// ------------------------------------------------------------

model PlayerVideo {
  id String @id @default(cuid())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  status VideoStatus @default(NOT_SUBMITTED)

  // DIRECT_UPLOAD or EXTERNAL_LINK
  sourceType String?

  externalUrl String?

  storageProvider String?
  storageKey      String?
  playbackUrl     String?

  originalFilename String?
  mimeType         String?
  sizeBytes        BigInt?
  durationSeconds  Int?

  submittedAt DateTime?
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([status])
}

// ------------------------------------------------------------
// PAYMENT
// ------------------------------------------------------------

model Payment {
  id String @id @default(cuid())

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  status PaymentStatus @default(PENDING)

  provider String

  providerReference   String? @unique
  providerTransaction String?

  // Stored in minor currency units.
  // Example: ₦100,000 = 10000000 kobo
  amount   Int
  currency String

  // Original event price
  baseAmount   Int?
  baseCurrency String?

  // FX quote used at checkout
  fxRate     Decimal?
  fxSource   String?
  fxQuotedAt DateTime?

  failureReason String?

  initiatedAt DateTime  @default(now())
  paidAt      DateTime?
  refundedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([status])
  @@index([createdAt])
}

// ------------------------------------------------------------
// SCOUT
// ------------------------------------------------------------

model Scout {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  fullName String
  email    String?
  phone    String?

  organisationName String?
  organisationType String?
  role             String?
  country          String?

  verified Boolean @default(false)

  interests ScoutInterest[]

  requestedIntroductions Introduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([organisationName])
}

// ------------------------------------------------------------
// SCOUT INTEREST
// Interest does NOT equal an ASCEND introduction.
// ------------------------------------------------------------

model ScoutInterest {
  id String @id @default(cuid())

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id])

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  level ScoutInterestLevel @default(WATCH)

  privateNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scoutId, registrationId])
  @@index([registrationId])
  @@index([level])
}

// ------------------------------------------------------------
// ASCEND INTRODUCTION
//
// This record is created only when ASCEND formally facilitates
// contact arising from the Showcase.
// ------------------------------------------------------------

model Introduction {
  id String @id @default(cuid())

  introductionNumber String @unique

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])

  requestedByScoutId String
  requestedByScout   Scout  @relation(fields: [requestedByScoutId], references: [id])

  status IntroductionStatus @default(REQUESTED)

  // Who ASCEND should route the opportunity through.
  routedTo IntroductionPartyType?

  representationStatusAtRequest RepresentationStatus?

  requestReason String?
  internalNotes String?

  requestedAt  DateTime  @default(now())
  approvedAt   DateTime?
  introducedAt DateTime?
  closedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([registrationId])
  @@index([requestedByScoutId])
  @@index([status])
}
